# Copy to .env and fill in. .env is gitignored.
# Save WITHOUT a UTF-8 BOM — the loader strips one defensively, but other tools
# reading .env may not.

# =============================================================================
# SAFETY FLAGS
# =============================================================================

# MASTER SWITCH. Golden ID issuance is OFF by default and must stay off until:
#   1. the ownership chain is enforced and the cross-application isolation
#      suite passes with zero leakage;
#   2. the capability registry rejects fields a document cannot carry;
#   3. the decision policy blocks issuance on any integrity signal.
# All three are implemented and tested — set this to true deliberately, not
# by habit.
ENABLE_ISSUANCE=false

# Reject fields a document/page cannot carry (a passport father_name, a PAN
# address). Turning this off re-opens the hallucination path.
ENFORCE_CAPABILITIES=true

# Refuse any comparison referencing a document owned by another application.
ENFORCE_OWNERSHIP=true

# Block comparison until every selected document reaches a final state.
ENFORCE_COMPARISON_BARRIER=true

# Reject unreadable images rather than extracting hallucinated fields from them.
ENFORCE_QUALITY_GATE=true

# Folder / ZIP / multi-page PDF discovery.
ENABLE_BULK_UPLOAD=true

# =============================================================================
# CLOUDFLARE WORKERS AI
# =============================================================================
# Without these the app still runs; extraction falls back to local OCR.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Verify with `npm run check:models` — the Workers AI catalog changes often.
# @cf/google/gemma-3-12b-it was RETIRED on 2026-05-30; do not use it.
CF_MODEL_PRIMARY=@cf/moondream/moondream3.1-9B-A2B
CF_MODEL_CROSS_CHECK=@cf/meta/llama-3.2-11b-vision-instruct

# always | on-low-confidence
CROSS_CHECK_MODE=on-low-confidence

# Re-read a file with the correct document's prompt when the backend overrules
# the model's classification.
RECLASSIFY_ON_CORRECTION=true

CF_TIMEOUT_MS=15000
CF_RETRIES=2
EXTRACT_CONCURRENCY=5

# =============================================================================
# SERVER
# =============================================================================
PORT=3000

# Echo the demo OTP in the API response. MUST be false anywhere reachable
# beyond localhost, or the OTP is not a second factor at all.
EXPOSE_DEMO_OTP=true

# =============================================================================
# FACE MATCHING — advisory only, never blocks issuance
# =============================================================================
# A guess until `node scripts/face-benchmark.js <samples>` has been run over
# labelled document photographs. One real pair measured 0.65; that is one pair,
# not a calibration.
FACE_MATCH_THRESHOLD=0.5
FACE_MATCH_ENABLED=true

# =============================================================================
# STORAGE
# =============================================================================
DB_PATH=./golden-id.sqlite
UPLOAD_DIR=./.uploads
UPLOAD_TTL_MS=1800000
UPLOAD_SWEEP_MS=300000
RETENTION_DAYS=7

# =============================================================================
# SIGNING
# =============================================================================
# The Ed25519 private key is generated on first run and MUST live outside the
# repository. Default: ~/.golden-id/signing-key.pem
GOLDEN_ID_KEY_PATH=

SHARE_TTL_MS=900000
